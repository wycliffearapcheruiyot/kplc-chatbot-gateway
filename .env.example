# ---------------------------------------------------------------------------
# Everything below except MONGODB_URI can ALSO be changed live from the admin
# panel's Environment tab (stored in MongoDB; wins over these env vars).
# Gateway env vars. On Render set these in the dashboard (Environment tab),
# NOT in a .env file. Locally: copy to .env (git-ignored).
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (database: kplc_chatbot)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0"

# The two Render services this gateway connects.
# Session backend: starts the Kaggle GPU session and proxies /generate + /embed.
SESSION_BACKEND_URL="https://kplc-kaggle-notebook-instance.onrender.com"

# Dataset backend: makes sure the model files exist as a Kaggle dataset.
# Leave DATASET_BACKEND_URL empty to skip the dataset check entirely.
DATASET_BACKEND_URL="https://dataset-trigger-backend.onrender.com"
# Must equal DATASET_TRIGGER_SECRET on the dataset backend.
DATASET_TRIGGER_SECRET="paste-the-dataset-backend-secret"

# Guards the admin endpoints (/chunks*, /chat_logs). Pick a long random string:
#   openssl rand -hex 32
# The admin panel sends it as the X-Admin-Token header. If unset, the admin
# endpoints are disabled (503) rather than left open.
ADMIN_TOKEN="change-this-to-a-long-random-string"

# Exact frontend origins allowed to call this API, comma-separated, no
# trailing slash and no path (a mismatch is the classic "works in curl, fails
# in the browser" bug).
ALLOWED_ORIGINS="https://your-chatbot.vercel.app,https://your-admin.netlify.app"

# --- optional tuning -------------------------------------------------------
# Free-tier services take 30-60s to wake; these give calls room to.
# UPSTREAM_TIMEOUT_SECONDS=90
# GENERATE_TIMEOUT_SECONDS=150
# EMBED_TIMEOUT_SECONDS=150
# Give up on a dataset build after this long (dataset backend's own limit is 90)
# DATASET_PENDING_MAX_MINUTES=100
